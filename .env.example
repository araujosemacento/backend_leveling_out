# Configurações do Servidor PocketBase
PORT=8090
HOST=127.0.0.1

# Higienização de Dados (minutos de inatividade antes de expirar uma sala)
CLEANUP_INACTIVITY_MINUTES=15

# URL pública de exposição (via Tailscale Funnel ou Cloudflare Tunnel)
# Exemplo Tailscale: https://sua-maquina.seu-tailnet.ts.net
# Exemplo Cloudflare: https://leveling-out-api.seu-dominio.com
PUBLIC_SERVER_URL=http://localhost:8090
